<Window x:Class="GestaoProdutos.UI.Views.ProdutoFormAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestaoProdutos.UI.Views"
        xmlns:behaviors="clr-namespace:GestaoProdutos.UI.Behaviors"
        mc:Ignorable="d"
        Title="Adicionar / Editar Produto" WindowStartupLocation="CenterScreen" Height="267" MinWidth="391" MinHeight="267" VerticalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Disabled" ResizeMode="NoResize" HorizontalContentAlignment="Center" HorizontalAlignment="Center" MaxHeight="267" MaxWidth="391">

    <Grid MinWidth="391" MaxWidth="391" MinHeight="251.04" MaxHeight="251.04">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="282"/>
            <ColumnDefinition Width="109"/>
        </Grid.ColumnDefinitions>
        <Grid HorizontalAlignment="Right" Height="38" Margin="0,24,10,0" VerticalAlignment="Top" Width="371" Grid.ColumnSpan="2">
            <Label Content="Nome"  
                HorizontalAlignment="Left"
                Height="28" 
                VerticalAlignment="Center" 
                Width="89" 
                VerticalContentAlignment="Center" 
                ScrollViewer.VerticalScrollBarVisibility="Disabled" 
                IsEnabled="False" FontSize="14"/>
            <Border BorderBrush="#FFC7C7C7" 
                BorderThickness="1">
                <TextBox x:Name="txtNome" 
                    Height="28" Margin="97,4,3,4"
                    FontSize="14" HorizontalScrollBarVisibility="Disabled" 
                    Padding="3,3,3,3" 
                    Text="{Binding Nome}" 
                    TextWrapping="WrapWithOverflow" TabIndex="1"/>
            </Border>


        </Grid>
        <Grid HorizontalAlignment="Left" Height="38" VerticalAlignment="Center" Width="371" Grid.ColumnSpan="2" Margin="10,0,0,0">
            <Label Content="Quantidade"  
                HorizontalAlignment="Left"
                Height="28" 
                VerticalAlignment="Center" 
                Width="89" 
                VerticalContentAlignment="Center" 
                ScrollViewer.VerticalScrollBarVisibility="Disabled" 
                IsEnabled="False" FontSize="14"/>
            <Border BorderBrush="#FFC7C7C7" 
                BorderThickness="1">
                <TextBox x:Name="txtQuant" 
                    Height="28" Margin="97,4,3,4"
                    FontSize="14" HorizontalScrollBarVisibility="Disabled" 
                    Padding="3,3,3,3" 
                    Text="{Binding Quant, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                    behaviors:TextBoxBehaviors.OnlyNumbers="True"
                    TextWrapping="WrapWithOverflow" 
                    InputScope="Number"
                    AcceptsTab="True" TabIndex="3"/>
            </Border>


        </Grid>
        <Grid HorizontalAlignment="Left" Height="38" Margin="10,147,0,0" VerticalAlignment="Top" Width="371" Grid.ColumnSpan="2">
            <Label Content="Preço"  
                HorizontalAlignment="Left"
                Height="28" 
                VerticalAlignment="Center" 
                Width="89" 
                VerticalContentAlignment="Center" 
                ScrollViewer.VerticalScrollBarVisibility="Disabled" 
                IsEnabled="False" FontSize="14"/>
            <Border BorderBrush="#FFC7C7C7" 
                BorderThickness="1">
                <TextBox x:Name="txtPreco" 

                    Height="28" Margin="97,4,3,4"
                    FontSize="14" HorizontalScrollBarVisibility="Disabled" 
                    Padding="3,3,3,3" 
                    Text="{Binding Preco, StringFormat={}{0:C}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"                   
                    TextWrapping="WrapWithOverflow" PreviewTextInput="txtPreco_PreviewTextInput" TextChanged="txtPreco_TextChanged" TabIndex="4" AcceptsTab="True"/>
            </Border>


        </Grid>
        <Grid HorizontalAlignment="Left" Height="38" Margin="10,64,0,0" VerticalAlignment="Top" Width="371" Grid.ColumnSpan="2">
            <Label Content="Descrição"  
                HorizontalAlignment="Left"
                Height="28" 
                VerticalAlignment="Center" 
                Width="89" 
                VerticalContentAlignment="Center" 
                ScrollViewer.VerticalScrollBarVisibility="Disabled" 
                IsEnabled="False" FontSize="14"/>
            <Border BorderBrush="#FFC7C7C7" 
                BorderThickness="1" 
                Height="38">
                <TextBox x:Name="txtDescr1" 
                    Height="28" Margin="97,4,3,4"
                    FontSize="14" 
                    HorizontalScrollBarVisibility="Disabled" 
                    Padding="3,3,3,3" 
                    Text="{Binding Descricao}" 
                    TextWrapping="WrapWithOverflow" AcceptsTab="True" TabIndex="2"
                    />
            </Border>


        </Grid>
        <Button Content="OK" BorderThickness="1,1,1,1" Foreground="#FF176707" FontSize="13" FontWeight="Bold" Background="#FFCACACA" Command="{Binding OkProdutoCommand}" TabIndex="5" Margin="196,192,0,36"/>
        <Button Content="SAIR"  Height="23" Margin="0,192,0,0" VerticalAlignment="Top" Width="88" BorderThickness="1,1,1,1" Foreground="#FF670707" FontSize="13" FontWeight="Bold" Background="#FFCACACA" HorizontalAlignment="Center" TabIndex="6" Grid.Column="1"/>


    </Grid>
</Window>
